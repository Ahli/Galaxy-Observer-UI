<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
  <Frame type="UnitStatusFrame" name="AbathurSymbioteMinimapIconTemplate" template="MinimapUnitStatus/UnitStatusMinimapIconFrameTemplate">
    <AllyRenderPriority val="#RenderPriorityHero_Ally" />
    <EnemyRenderPriority val="#RenderPriorityHero_Enemy" />
    <OwnerRenderPriority val="#RenderPriorityHero_Owner" />
    <VisibleToOwner val="true" />
    <VisibleToAlly val="true" />
    <VisibleToEnemy val="true" />
    <Frame type="Frame" name="AttachPointFrame">
      <Anchor side="Top" relative="$parent" pos="Min" offset="40" />
      <Anchor side="Left" relative="$parent" pos="Min" offset="16" />
      <Height val="2" />
      <Width val="2" />
      <Visible val="False" />
    </Frame>
    <Frame type="UnitStatusMinimapIcon" name="UnitStatusMinimapIcon">
      <FacingOffset val="270.0" />
      <Frame type="Image" name="IconImage">
        <SubpixelRendering val="true" />
        <Texture val="{$parent/@MinimapIcon}" layer="0" />
        <LayerColor val="{$parent/@Color}" layer="0" />
      </Frame>
    </Frame>
  </Frame>
  <Frame type="UnitStatusFrame" name="AbathurSymbioteMinimapIconHero" template="Abathur/AbathurSymbioteMinimapIconTemplate">
    <Frame type="Frame" name="AttachPointFrame">
      <Anchor side="Top" relative="$parent" pos="Min" offset="33" />
    </Frame>
  </Frame>
  <Frame type="UnitStatusFrame" name="AbathurSymbioteMinimapIconMinion" template="Abathur/AbathurSymbioteMinimapIconTemplate">
    <Frame type="Frame" name="AttachPointFrame">
      <Anchor side="Top" relative="$parent" pos="Min" offset="25" />
    </Frame>
  </Frame>
  <Frame type="UnitStatusFrame" name="AbathurSymbioteMinimapIconTownHall" template="Abathur/AbathurSymbioteMinimapIconTemplate">
    <Frame type="Frame" name="AttachPointFrame">
      <Anchor side="Top" relative="$parent" pos="Min" offset="42" />
    </Frame>
  </Frame>
  <Frame type="UnitStatusFrame" name="AbathurSymbioteMinimapIconCore" template="Abathur/AbathurSymbioteMinimapIconTemplate">
    <Frame type="Frame" name="AttachPointFrame">
      <Anchor side="Top" relative="$parent" pos="Min" offset="38" />
    </Frame>
  </Frame>
  <Frame type="UnitStatusFrame" name="AbathurSymbioteMinimapIconStructure" template="Abathur/AbathurSymbioteMinimapIconTemplate">
    <Frame type="Frame" name="AttachPointFrame">
      <Anchor side="Top" relative="$parent" pos="Min" offset="25" />
    </Frame>
  </Frame>
  <Frame type="UnitStatusFrame" name="AbathurSymbioteMinimapIconMonstrosity" template="Abathur/AbathurSymbioteMinimapIconTemplate">
    <Frame type="Frame" name="AttachPointFrame">
      <Anchor side="Top" relative="$parent" pos="Min" offset="27" />
    </Frame>
  </Frame>
  <Frame type="UnitStatusFrame" name="AbathurSymbioteMinimapIconMerc" template="Abathur/AbathurSymbioteMinimapIconTemplate">
    <Frame type="Frame" name="AttachPointFrame">
      <Anchor side="Top" relative="$parent" pos="Min" offset="28" />
    </Frame>
  </Frame>
  <Frame type="SelectionUnitStatusPanel" name="AbathurFrameWithPetHealth">
    <Anchor side="Bottom" relative="$parent" pos="Max" offset="0" />
    <Anchor side="Left" relative="$parent" pos="Min" offset="0" />
    <Height val="200" />
    <Width val="300" />
    <SpecificUnit val="HeroAbathur" />
    <Frame type="UnitStatusFrame" name="UnitStatusFrame0">
      <Anchor relative="$parent" />
      <StateGroup name="MonstrosityState">
        <DefaultState val="NoMonstrosity" />
        <State name="NoMonstrosity">
          <When type="Property" frame="$this/MonstrosityActiveAnim" Visible="False" />
          <Action type="SetProperty" frame="$this/FrameImage" Visible="False" />
          <Action type="SetProperty" frame="$this/AbathurMonstrosityTrackingElement/TrackedUnitStatusFrame0" Visible="False" />
          <Action type="SetProperty" frame="$this/UnitStatusBehaviorLabel/StackLabel" Visible="False" />
        </State>
        <State name="MonstrosityHasSymbiote">
          <When type="Property" frame="$this/MonstrosityActiveAnim" Visible="True" />
          <When type="Property" frame="$this/MonstrositySymbioteActiveAnim" Visible="True" />
          <Action type="SetProperty" frame="$this/FrameImage" Visible="False" />
          <Action type="SetProperty" frame="$this/AbathurMonstrosityTrackingElement/TrackedUnitStatusFrame0" Visible="False" />
          <Action type="SetProperty" frame="$this/UnitStatusBehaviorLabel/StackLabel" Visible="True" />
          <Action type="SetAnchor" frame="UnitStatusBehaviorLabel" side="Top" relative="$parent" pos="Min" offset="160" />
          <Action type="SetAnchor" frame="UnitStatusBehaviorLabel" side="Left" relative="$parent" pos="Min" offset="43" />
          <Action type="SetAnchor" frame="UnitStatusBehaviorLabel" side="Bottom" relative="$parent" pos="Max" offset="0" />
          <Action type="SetAnchor" frame="UnitStatusBehaviorLabel" side="Right" relative="$parent" pos="Max" offset="-10" />
        </State>
        <State name="MonstrosityActiveNoSymbiote">
          <When type="Property" frame="$this/MonstrosityActiveAnim" Visible="True" />
          <When type="Property" frame="$this/MonstrositySymbioteActiveAnim" Visible="False" />
          <Action type="SetProperty" frame="$this/FrameImage" Visible="True" />
          <Action type="SetProperty" frame="$this/AbathurMonstrosityTrackingElement/TrackedUnitStatusFrame0" Visible="True" />
          <Action type="SetProperty" frame="$this/UnitStatusBehaviorLabel/StackLabel" Visible="True" />
          <Action type="SetAnchor" frame="UnitStatusBehaviorLabel" side="Top" relative="$parent/FrameImage" pos="Min" offset="10" />
          <Action type="SetAnchor" frame="UnitStatusBehaviorLabel" side="Left" relative="$parent/FrameImage" pos="Min" offset="102" />
          <Action type="SetAnchor" frame="UnitStatusBehaviorLabel" side="Bottom" relative="$parent/FrameImage" pos="Max" offset="-15" />
          <Action type="SetAnchor" frame="UnitStatusBehaviorLabel" side="Right" relative="$parent/FrameImage" pos="Max" offset="-5" />
        </State>
      </StateGroup>
      <Frame type="Image" name="FrameImage">
        <Anchor side="Bottom" relative="$parent" pos="Max" offset="0" />
        <Anchor side="Left" relative="$parent" pos="Min" offset="0" />
        <Texture val="@UI/Storm_UI_InGame_PetHealthbar" />
        <Visible val="{$parent/MonstrosityActiveAnim/@Visible}" />
      </Frame>
      <Frame type="UnitStatusBehaviorLabel" name="UnitStatusBehaviorLabel">
        <Anchor side="Top" relative="$parent/FrameImage" pos="Min" offset="10" />
        <Anchor side="Left" relative="$parent/FrameImage" pos="Min" offset="102" />
        <Anchor side="Bottom" relative="$parent/FrameImage" pos="Max" offset="-15" />
        <Anchor side="Right" relative="$parent/FrameImage" pos="Max" offset="-5" />
        <Behavior val="AbathurEvolveMonstrosityQuestStack" />
        <RenderPriority val="520" />
        <Frame type="Label" name="StackLabel">
          <Anchor relative="$parent" />
          <Style val="Storm_HeroSpecificValueLabel" />
        </Frame>
      </Frame>
      <Frame type="UnitStatusUnitTrackingBehavior" name="AbathurMonstrosityTrackingElement">
        <Anchor relative="$parent" />
        <Behavior val="AbathurEvolveMonstrosityTrackingBehavior" />
        <Frame type="UnitStatusFrame" name="TrackedUnitStatusFrame0" template="UnitStatus/HeroUnitStatusConsoleFrameTemplate">
          <Anchor side="Top" relative="$parent/$parent/FrameImage" pos="Min" offset="0" />
          <Anchor side="Left" relative="$parent/$parent/FrameImage" pos="Min" offset="0" />
          <Width val="270" />
          <Height val="70" />
          <Frame type="UnitStatusShieldedHealthBar" name="HealthBar" template="UnitStatus/UnitStatusShieldedHealthBarTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="45" />
            <Anchor side="Left" relative="$parent" pos="Min" offset="106" />
            <Width val="153" />
            <Height val="17" />
            <Texture val="@UI/Storm_UI_InGame_PetHealth" />
          </Frame>
          <Frame type="UnitStatusShieldedHealthLabel" name="HealthBarLabel">
            <Anchor side="Top" relative="$parent/HealthBar" pos="Min" offset="-3" />
            <Anchor side="Left" relative="$parent/HealthBar" pos="Min" offset="13" />
            <Anchor side="Bottom" relative="$parent/HealthBar" pos="Max" offset="4" />
            <Anchor side="Right" relative="$parent/HealthBar" pos="Max" offset="-20" />
            <Frame type="Label" name="StatusLabel">
              <Anchor relative="$parent" />
            </Frame>
          </Frame>
          <Frame type="Frame" name="AbathurMonstrosityFrameContainer">
            <Anchor side="Top" relative="$parent" pos="Min" offset="11" />
            <Anchor side="Left" relative="$parent" pos="Min" offset="15" />
            <Width val="94" />
            <Height val="51" />
            <Frame type="Image" name="AbathurMonstrosityIcon">
              <Anchor side="Top" relative="$parent" pos="Mid" offset="0" />
              <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0" />
              <Anchor side="Left" relative="$parent" pos="Mid" offset="0" />
              <Anchor side="Right" relative="$parent" pos="Mid" offset="0" />
              <Width val="94" />
              <Height val="94" />
              <Texture val="Assets\Textures\storm_ui_icon_abathur_evolvemonstrosity.dds" />
            </Frame>
            <Frame type="Frame" name="MaskFrame">
              <Anchor relative="$parent" />
              <AlphaMaskTexture val="@UI/Storm_UI_InGame_PetHealthbar_PortraitMask" />
              <AlphaMaskSiblings val="true" />
              <RenderPriority val="1" />
            </Frame>
          </Frame>
        </Frame>
      </Frame>
      <Frame type="UnitStatusValidatorAnimElement" name="MonstrositySymbioteActiveAnim">
        <Anchor relative="$parent" />
        <Validator val="AbathurHasTrackedMonstrosityUnitWithSymbiote" />
      </Frame>
      <Frame type="UnitStatusValidatorAnimElement" name="MonstrosityActiveAnim">
        <Anchor relative="$parent" />
        <Validator val="AbathurHasTrackedMonstrosityUnit" />
      </Frame>
    </Frame>
  </Frame>
  <Frame type="SelectionUnitStatusPanel" name="AbathurStacksFrameContainer">
    <Anchor relative="$parent" />
    <SpecificUnit val="HeroAbathur" />
    <Frame type="UnitStatusUnitStackingDebuffElement" name="SlapathurStatusFrame">
      <Anchor relative="$ancestor[@name=HeroUnitStatusParentFrame]/PlayerUnitNameLabel" />
      <BuffBehavior val="SlapathurInternalCooldown" />
      <ShowForBehaviorOwner val="True" />
      <Frame type="Image" name="SlapathurStatusBase">
        <Anchor side="Bottom" relative="$parent" pos="Min" offset="0" />
        <Anchor side="Left" relative="$parent" pos="Mid" offset="0" />
        <Anchor side="Right" relative="$parent" pos="Mid" offset="0" />
        <Texture val="@UI/Malfurion/RegrowthStatusBase" />
        <Visible val="true" />
        <Frame type="UnitStatusBehaviorIcon" name="SlapathurStatusCountdownFrame">
          <Behavior val="SlapathurInternalCooldown" />
          <Anchor relative="$parent" />
          <Frame type="BehaviorIcon" name="BehaviorIcon">
            <Anchor relative="$parent" />
            <AcceptsMouse val="False" />
            <Frame type="ProgressBar" name="CooldownBar">
              <Anchor side="Top" relative="$parent" pos="Mid" offset="0" />
              <Anchor side="Left" relative="$parent" pos="Mid" offset="0" />
              <Anchor side="Right" relative="$parent" pos="Mid" offset="0" />
              <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0" />
              <Height val="48" />
              <Width val="48" />
              <Color val="A00000" />
              <Circular val="True" />
              <CircularStart val="0" />
              <CircularEndOffset val="360" />
              <Frame type="Frame" name="FillImageContainer">
                <Anchor relative="$parent" />
                <Frame type="Image" name="FillImage">
                  <Anchor relative="$parent" />
                  <Texture val="@UI/Malfurion/RegrowthStatusBar" />
                  <TextureType val="Circular" />
                </Frame>
              </Frame>
              <Frame type="Image" name="SlapathurStatusCenterIcon">
                <Anchor relative="$parent" offset="-12" />
                <Texture val="@UI/State/StunnedIcon" />
                <Visible val="true" />
                <IgnoreParentColor val="true" />
              </Frame>
            </Frame>
          </Frame>
        </Frame>
      </Frame>
    </Frame>
  </Frame>
</Desc>
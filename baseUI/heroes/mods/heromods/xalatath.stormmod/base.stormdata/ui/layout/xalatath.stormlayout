          </Controller>
          <Controller type="Visibility" end="Pause" frame="$parent/VoidChargeDecay50">
            <Key type="Bool" time="0" value="false" />
          </Controller>
          <Controller type="Visibility" end="Pause" frame="$parent/VoidChargeDecay75">
            <Key type="Bool" time="0" value="false" />
          </Controller>
          <Controller type="Visibility" end="Pause" frame="$parent/VoidChargeOff">
            <Key type="Bool" time="0" value="true" />
          </Controller>
          <Controller type="Event" end="Stop" frame="$parent/VoidChargePrimed">
            <Key type="Event" time="0" event="StopPulse" />
          </Controller>
        </Animation>
      </Frame>
      <Frame type="Image" name="VoidChargePrimedGlow">
        <Anchor relative="$parent/VoidChargePrimed" />
        <Visible val="False" />
        <Unclipped val="True" />
        <BlendMode val="Add" />
        <ColorAdjustMode val="Colorize" />
        <LightAdjustColor val="9d64ff" />
        <DarkAdjustColor val="2b0c66" />
        <Texture val="@UI/Storm_UI_GenFX_Flare" />
        <Animation name="Pulse">
          <Event event="OnShown" action="Restart,Play" />
          <Controller type="Fade" end="Loop">
            <Key type="Curve" time="0" value="20" inout="Linear,Slow" />
            <Key type="Curve" time=".45" value="90" inout="Slow,Linear" />
            <Key type="Curve" time=".9" value="20" inout="Slow,Linear" />
          </Controller>
        </Animation>
      </Frame>
      <Frame type="UnitStatusValidatorAnimElement" name="VoidVolleyChargeGlowActive">
        <Anchor relative="$parent" />
        <Validator val="XalatathVoidVolleyChargePrimedNotDecayingValidator" />
        <Animation name="VoidVolleyChargeGlowActive">
          <Event event="Reset" action="Stop" />
          <Event event="NoState" action="Stop" />
          <Event event="XalatathVoidVolleyChargePrimedNotDecayingValidator" action="Restart,Play" />
          <Controller type="Visibility" end="Pause" frame="$parent/VoidChargePrimedGlow">
            <Key type="Bool" time="0" value="True" />
          </Controller>
        </Animation>
      </Frame>

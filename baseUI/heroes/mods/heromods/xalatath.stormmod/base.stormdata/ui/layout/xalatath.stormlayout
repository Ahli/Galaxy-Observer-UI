<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
  <Animation name="Glow">
    <Event event="OnShown" action="Restart,Play" />
    <Controller type="Fade" end="Loop">
      <Key type="Curve" time="0" value="50" inout="Linear,Slow" />
      <Key type="Curve" time=".4" value="255" inout="Linear,Slow" />
      <Key type="Curve" time=".6" value="255" inout="Slow,Linear" />
      <Key type="Curve" time="1.4" value="50" inout="Slow,Linear" />
    </Controller>
  </Animation>
  <Frame type="SelectionUnitStatusPanel" name="XalatathStacksFrameContainer">
    <Anchor relative="$parent" />
    <SpecificUnit val="HeroXalatath" />
    <CheckPassengers val="True" />
    <Frame type="UnitStatusUnitStackingDebuffElement" name="XalatathShadowMarkStacksFrame" template="UnitStatus/SingleBehaviorTemplate">
      <BuffBehavior val="XalatathShadowMarkDebuff" />
      <ShowForAllyMirrorHero val="True" />
      <Frame type="Image" name="StacksFull">
        <Anchor side="Top" relative="$parent" pos="Min" offset="-5" />
        <Anchor side="Left" relative="$parent" pos="Min" offset="-5" />
        <Texture val="@UI/Storm_UI_Marker_Xalatath_Darkheart" />
      </Frame>
    </Frame>
  </Frame>
  <Frame type="SelectionUnitStatusPanel" name="XalatathFrame">
    <Anchor side="Left" relative="$parent" pos="Min" offset="41" />
    <Anchor side="Bottom" relative="$parent" pos="Max" offset="-4" />
    <Height val="140" />
    <Width val="250" />
    <AcceptsMouse val="false" />
    <SpecificUnit val="HeroXalatath" />
    <Frame type="Image" name="ChromeRingImage">
      <Anchor side="Right" relative="$parent" pos="Min" offset="-32" />
      <Anchor side="Bottom" relative="$parent" pos="Min" offset="30" />
      <Width val="30" />
      <Height val="30" />
      <Visible val="false" />
    </Frame>
    <Frame type="BehaviorIcon" name="XalatathVoidChargeTooltip" template="StandardHeroUITemplates/SmallBehaviorTooltiptemplate">
      <Behavior val="XalatathVoidVolleyChargeTokenCounter" />
    </Frame>
    <Frame type="UnitStatusFrame" name="UnitStatusFrame0">

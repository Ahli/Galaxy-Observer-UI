      <Frame type="UnitStatusValidatorAnimElement" name="XalatathDeathAndStasisAnim">
        <Anchor relative="$parent" />
        <Validator val="CasterisDeadorStasis" />
        <Animation name="XalatathIsDead">
          <Event event="Reset" action="Stop" />
          <Event event="NoState" action="Stop" />
          <Event event="CasterisDeadorStasis" action="Restart, Play" />
          <Controller type="Visibility" end="Pause" frame="$parent/VoidCharge1">
            <Key type="Bool" time="0" value="false" />
          </Controller>
          <Controller type="Visibility" end="Pause" frame="$parent/VoidCharge2">
            <Key type="Bool" time="0" value="false" />
          </Controller>
          <Controller type="Visibility" end="Pause" frame="$parent/VoidCharge3">
            <Key type="Bool" time="0" value="false" />
          </Controller>
          <Controller type="Visibility" end="Pause" frame="$parent/VoidCharge4">
            <Key type="Bool" time="0" value="false" />
          </Controller>
          <Controller type="Visibility" end="Pause" frame="$parent/VoidChargePrimed">

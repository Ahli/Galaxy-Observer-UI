<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    <DescFlags val="Locked"/>

    <Frame type="BDKCheckoutDialog" name="BDKCheckoutDialog" template="StandardDialog/StandardDialogTemplate">
        <Anchor relative="$parent"/>

        <Frame type="Image" name="IdleSpinner" template="StandardTemplates/IdleSpinnerTemplate">
            <Anchor side="Top" relative="$parent/TitleLabel" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
            <Visible val="false"/>
            <LayerColor val="0e86ca"/>
        </Frame>

        <StateGroup name="DialogState">
            <DefaultState val="Rendering"/>
            <State name="InitializingBDK">
                <When type="Property" frame="$this" State="InitializingBDK"/>
                <Action type="SetProperty" frame="IdleSpinner" Visible="true"/>
                <Action type="SetProperty" frame="Button" Visible="true"/>
                <Action type="SetProperty" frame="Button" Text="@UI/StandardDialog_Cancel_Control"/>
                <Action type="SetProperty" frame="MessageLabel" Visible="false"/>
            </State>
            <State name="ShowingOverlay">
                <When type="Property" frame="$this" State="ShowingOverlay"/>
                <Action type="SetProperty" frame="IdleSpinner" Visible="true"/>
                <Action type="SetProperty" frame="Button" Visible="true"/>
                <Action type="SetProperty" frame="Button" Text="@UI/StandardDialog_Cancel_Control"/>
                <Action type="SetProperty" frame="MessageLabel" Visible="false"/>
            </State>
            <State name="InvalidParams">
                <When type="Property" frame="$this" State="ErrorInvalidParams"/>
                <Action type="SetProperty" frame="IdleSpinner" Visible="false"/>
                <Action type="SetProperty" frame="Button" Visible="true"/>
                <Action type="SetProperty" frame="Button" Text="@UI/StandardDialog_Ok_Control"/>
                <Action type="SetProperty" frame="MessageLabel" Visible="true"/>
                <Action type="SetProperty" frame="MessageLabel" Text="@UI/ProductPurchase/InvalidProduct"/>
            </State>
            <State name="ErrorBDKInitFailed">
                <When type="Property" frame="$this" State="ErrorBDKInitFailed"/>
                <Action type="SetProperty" frame="IdleSpinner" Visible="false"/>
                <Action type="SetProperty" frame="Button" Visible="true"/>
                <Action type="SetProperty" frame="Button" Text="@UI/StandardDialog_Ok_Control"/>
                <Action type="SetProperty" frame="MessageLabel" Visible="true"/>
                <Action type="SetProperty" frame="MessageLabel" Text="@UI/ProductPurchase/InvalidProduct"/>
            </State>
            <State name="Rendering">
                <Action type="SetProperty" frame="Button" Visible="false"/>
                <Action type="SetProperty" frame="MessageLabel" Visible="false"/>
                <Action type="SetProperty" frame="IdleSpinner" Visible="false"/>
            </State>
        </StateGroup>
    </Frame>
</Desc>
